<?xml version="1.0" encoding="UTF-8"?>


<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- FQDN 사용할 DAO의 클래스명을 풀패키지명으로 작성 -->
<mapper namespace="com.gguek.app.departments.DepartmentMapper">
	<!-- 쿼리 태그 -->
	<!-- ID : DAO에서 사용할 메서드명을 ID로 작성 -->
	<!-- 컬럼명과 resultType의 Bean의 Setter 이름이 같은 걸 찾아서 대입 -->
	
	<select id="getCount" resultType="Long">
	SELECT COUNT(DEPARTMENT_NO) FROM TB_DEPARTMENT
	</select>
	
	<select id="list" parameterType="java.util.Map"
		resultType="DepartmentDTO">
		SELECT * 
		FROM
		(
			SELECT ROWNUM R, T.* 
			FROM 
			(
				SELECT *
				FROM TB_DEPARTMENT
				ORDER BY DEPARTMENT_NO DESC
			) T
		)
		WHERE R BETWEEN #{begin} AND #{end}
	</select>

	<select id="detail"
		resultType="DepartmentDTO"
		parameterType="DepartmentDTO">
		<!-- String, primitive Type 은 DAO에 보낸 변수명을 #{변수명} 작성 -->
		SELECT *
		FROM TB_DEPARTMENT
		WHERE DEPARTMENT_NO = #{departmentNo}
	</select>

	<!-- INSERT, UPDATE, DELETE는 resultType이 존재하지 않음. -->
	<!-- 결과물은 숫자(int)로 리턴을 함. -->
	<insert id="create"
		parameterType="DepartmentDTO">
		INSERT INTO TB_DEPARTMENT
		<!-- Bean의 Getter에 이름을 #{}에 작성 -->
		VALUES(
			#{departmentNo},
			#{departmentName},
			#{category},
			#{openYn},
			#{capacity}
			)
	</insert>


	<delete id="delete"
		parameterType="DepartmentDTO">
		DELETE
			TB_DEPARTMENT
		WHERE
			DEPARTMENT_NO = #{departmentNo}
	</delete>


	<update id="update"
		parameterType="DepartmentDTO">
		UPDATE
			TB_DEPARTMENT
		SET
			DEPARTMENT_NAME = #{departmentName},
			CATEGORY = #{category},
			OPEN_YN = #{openYn},
			CAPACITY = #{capacity}
		WHERE
			DEPARTMENT_NO = #{departmentNo}
	</update>
</mapper>
  
